{
  "name": "weight-of-surveillance-pilot",
  "version": "1.0.0",
  "description": "The Weight of Surveillance: measuring third-party tracking on German websites in three consent states",
  "scripts": {
    "setup": "npx playwright install chromium",
    "lists": "bash scripts/update_lists.sh",
    "mock": "node crawler/crawl.mjs --mock --out data/raw/mock --window 10",
    "crawl": "node crawler/crawl.mjs --sites sample/sites_real_browser.csv --out data/raw/new_run --workers 2 --real-browser",
    "reclassify": "node crawler/reclassify.mjs data/raw/pilot_v1",
    "report": "python3 scripts/analyze.py data/raw/pilot_v1"
  },
  "keywords": [],
  "author": "",
  "license": "ISC",
  "dependencies": {
    "@duckduckgo/autoconsent": "^16.57.0",
    "@ghostery/adblocker": "^2.20.1",
    "playwright": "^1.64.1",
    "tldts": "^7.4.19"
  },
  "private": true
}
